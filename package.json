{
  "name": "ai6p-2160-reconcile-proof",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "gen:tokens": "node scripts/gen-tokens-css.mjs",
    "build": "node scripts/gen-aws-config.mjs && node scripts/gen-tokens-css.mjs && tsc -b && vite build",
    "build:ci": "node scripts/gen-tokens-css.mjs && tsc -b && vite build",
    "build:preview": "node scripts/gen-tokens-css.mjs && vite build --config vite.preview.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:verify": "npm run lint && npm run typecheck && npm test && npm run build:ci"
  },
  "dependencies": {
    "aws-amplify": "^6.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "8.19.0",
    "vite": "^6.0.0",
    "vitest": "2.1.8"
  }
}
